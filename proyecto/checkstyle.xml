<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle del Proyecto Biblioteca (Capitulo 15).
  Comprueba una unica regla, ya vigente en el
  proyecto desde el Volumen 1: ninguna linea de
  codigo supera las 66 columnas. Las lineas "import"
  quedan fuera a proposito: es la unica excepcion ya
  documentada para codigo Java en toda la coleccion
  (los nombres de paquete de Spring no se pueden
  partir). No hay mas modulos activos: introducir
  reglas de estilo adicionales aqui reabriria
  decisiones de formato de capitulos ya cerrados que
  nadie ha pedido revisar.
-->
<module name="Checker">
  <module name="TreeWalker">
    <module name="LineLength">
      <property name="max" value="66"/>
      <property name="ignorePattern" value="^import .*$"/>
    </module>
  </module>
</module>
